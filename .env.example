# Copy to .env and fill in. NEVER commit .env or your SSH key.

# ---- Phoenix ERP mock (URL + team token from Builder Base / Discord) ----
PHOENIX_API_BASE_URL=https://REPLACE-with-phoenix-url
PHOENIX_API_TOKEN=replace-with-your-team-token

# ---- Azure OpenAI (provided at hackathon Builder Base) ----
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your_project
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano

# ---- SSH (5 case keys — mount tb-hackathon-ssh/ as /keys in Docker) ----
SSH_KEYS_DIR=/keys
SSH_PRIVATE_KEY_PATH=/keys/case1_key.pem
# SSH_CONNECT_TIMEOUT=25
# SSH_CONNECT_RETRIES=3
# SSH_RETRY_DELAY_SECONDS=2

# ---- Supabase (from Lovable project — service role stays backend-only) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# ---- Gemini (recommended — multi-agent autopilot) ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
LLM_PRIMARY=gemini

# Thinking model — ticket understanding / hypothesis paths only (not command proposals)
GEMINI_THINKING_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=high
GEMINI_TICKET_THINKING_ENABLED=true

# ---- LLM fallback (optional) ----
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ---- Frontend → Backend ----
VITE_API_BASE=http://localhost:8000

# ---- Dev ----
MOCK_MODE=false
