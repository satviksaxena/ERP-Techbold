# =============================================================================
# Copy this file to .env and fill in values. NEVER commit .env to git.
# For Docker: use the /keys paths below for SSH (not your laptop paths).
# =============================================================================

# ---- Phoenix ERP mock ----
PHOENIX_API_BASE_URL=https://REPLACE-with-phoenix-url
PHOENIX_API_TOKEN=replace-with-your-team-token

# ---- SSH (Docker mounts tb-hackathon-ssh/ → /keys) ----
SSH_KEYS_DIR=/keys
SSH_PRIVATE_KEY_PATH=/keys/case1_key.pem
SSH_USERNAME=azureuser

# ---- Supabase (backend uses service role; frontend uses publishable key) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---- Gemini (recommended primary LLM) ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
LLM_PRIMARY=gemini
GEMINI_THINKING_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=high
GEMINI_TICKET_THINKING_ENABLED=true

# ---- Azure OpenAI (optional — set LLM_PRIMARY=azure to use) ----
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your_project
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano

# ---- Frontend → backend (leave as-is for Docker on localhost) ----
VITE_API_BASE=http://localhost:8000

# ---- Optional ----
MOCK_MODE=false
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
